# Normalize line endings. Text files are stored as LF in the repo AND checked
# out as LF on every platform, which removes the Windows "LF -> CRLF" warning
# and keeps diffs clean. Binary assets are left untouched.

* text=auto eol=lf

*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.xml   text eol=lf
*.svg   text eol=lf

# Binary — never convert
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
